---
import Base from '../layouts/Base.astro';
---
<Base title="Felipe Sztutman · 404" description="Página não encontrada. Page not found." showHeader={false}>
  <main class="notfound">
    <div class="code">404</div>
    <h1>Esta página não existe</h1>
    <p class="pt">O endereço pode ter mudado, ou a página ainda não foi escrita. O arquivo inteiro fica na entrada.</p>
    <p class="en"><strong>This page does not exist.</strong> The address may have changed, or the page has not been written yet. Some surfaces of this site exist only in Portuguese.</p>
    <nav class="ways">
      <a href="/">arquivo, em português</a>
      <a href="/en/">archive, in English</a>
    </nav>
  </main>
</Base>

<style>
  .notfound{min-height:100vh;background:#000000;color:#ffffff;display:flex;flex-direction:column;justify-content:center;padding:2rem 1.25rem;max-width:44rem;margin:0 auto}
  .code{font:.72rem/1 var(--mono);letter-spacing:.18em;color:rgba(255,255,255,.4);margin-bottom:1.5rem}
  h1{font:900 clamp(2.2rem,8vw,4.5rem)/.95 var(--sans);letter-spacing:-.04em;margin:0 0 1.5rem;max-width:12ch}
  p{font:1rem/1.6 var(--sans);max-width:52ch;margin:0 0 1rem;color:rgba(241,236,227,.72)}
  p.en{color:rgba(241,236,227,.5)}
  .ways{display:flex;gap:1.25rem;flex-wrap:wrap;margin-top:1.5rem}
  .ways a{font:.72rem/1 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.6);border-bottom:1px solid rgba(255,255,255,.25);padding-bottom:.3rem}
  .ways a:hover{color:#fff;border-color:#fff}
</style>
