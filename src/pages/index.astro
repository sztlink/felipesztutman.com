---
import Base from '../layouts/Base.astro';
import worksData from '../data/works.json';
import regimeData from '../data/work-regimes.json';
import galleryImages from '../data/gallery.json';

// Mais recente em cima: quem abre o site quer ver o agora, nao o comeco do arquivo.
const works = [...worksData.works].sort((a, b) => b.numero.localeCompare(a.numero));
const updatedAt = worksData.meta.generatedAt;
const total = worksData.meta.counts.total;
const realizada = worksData.meta.counts.realizada;
const emCurso = worksData.meta.counts.emCurso || 0;
const emExposicao = (worksData.meta.counts as any).emExposicao || 0;
const aConfirmar = worksData.meta.counts.aConfirmar;

const regimes = (regimeData as any).works || {};

const STRIP_SLUGS = ['cachoeira', 'oceanvs', 'metadata', 'sao-paulo-3024', 'andromeda', 'floresta-utopica', 'player1'];
// A coluna nasce do que existe de fato, senao obra sem galeria deixa buraco preto na capa.
const stripItems = STRIP_SLUGS
  .map((s) => ((galleryImages as any)[s] || [])[0])
  .filter(Boolean);
const regimeLabels: Record<string, string> = {
  A: 'fundacional / território / linhagem',
  B: 'sistema / corpo / mecanismo',
  C: 'espaço / circulação / colaboração',
};

function editorialStatus(work: any) {
  const labels: Record<string, string> = {
    AUTORAL_FELIPE: 'obra autoral de Felipe',
    COAUTORAL_FELIPE: 'obra coautoral',
    PROJETO_ARTISTA_TERCEIRO: 'projeto com artista terceiro',
    EXPOSICAO_TEMATICA: 'exposição temática / coletiva',
    DIRECAO_EXPERIENCIA: 'direção de experiência',
  };
  if (work.status === 'A_CONFIRMAR') {
    return work.authorshipMode === 'EXPOSICAO_TEMATICA' ? 'exposição em confirmação' : 'projeto em confirmação';
  }
  if (work.status === 'EM_CURSO') {
    return work.authorshipMode === 'EXPOSICAO_TEMATICA' ? 'exposição em produção' : 'obra em curso';
  }
  if (work.authorshipMode && labels[work.authorshipMode]) return labels[work.authorshipMode];
  if (work.tipo === 'ARTE_PUBLICA') return 'arte pública';
  if (work.tipo === 'INTERVENCAO_URBANA') return 'intervenção urbana';
  if (work.tipo === 'EXPOSICAO_DIRIGIDA') return 'exposição dirigida';
  if (work.tipo === 'INSTALACAO' && regimes[work.slug] === 'B') return 'instalação-sistema';
  if (work.tipo === 'INSTALACAO' && regimes[work.slug] === 'A') return 'gesto fundacional';
  if (regimes[work.slug] === 'C') return 'direção espacial';
  return 'obra';
}

function regimeLabel(work: any) {
  const regime = regimes[work.slug];
  return regime ? regimeLabels[regime] : null;
}
---
<Base
  title="Felipe Sztutman · artista, arte imersiva, luz e tecnologia"
  description="Arquivo de obra de Felipe Sztutman. Luz, tecnologia, percepção e sistemas imersivos organizados como obra e relação."
  schemaType="Person"
  fullBleed={true}
  showHeader={false}
  showFooter={false}
  bodyClass="page-home"
>
  <main class="home">
    <section class="entry">
      <div class="entry-strip" aria-hidden="true" style={`--cols:${stripItems.length};`}>
        {stripItems.map((item) => (
          <span class="strip-cell"><img src={item.src} alt={item.caption || ""} loading="eager" /></span>
        ))}
      </div>
      <div class="entry-meta">ARTE E TECNOLOGIA · São Paulo</div>
      <h1><span class="given">FELIPE</span>SZTUTMAN</h1>
      <div class="entry-hint">ROLAR PARA ENTRAR ↓</div>
    </section>

    <section class="statement" aria-label="statement">
      <div class="statement-label">STATEMENT</div>
      <p>Tornar visível o invisível.</p>
    </section>

    <section class="archive" id="obras">
      <div class="archive-head">
        <div class="archive-kicker">ARQUIVO</div>
        <h2>{total} obras</h2>
        <div class="archive-meta">São Paulo · ativo desde 2009 · {realizada} realizadas · {emExposicao > 0 && `${emExposicao} em exposição · `}{emCurso > 0 && `${emCurso} em produção · `}{aConfirmar} a confirmar · atualizado {updatedAt}</div>
        <p class="archive-note">Entrada pública do arquivo. As obras, sistemas e direções de experiência levam ao dossiê. O mapa lê relações sustentadas.</p>
      </div>

      <div class="archive-table-wrap">
        <table class="archive-table">
          <thead>
            <tr>
              <th>Nº</th>
              <th>OBRA</th>
              <th>ANO</th>
              <th>LOCAL</th>
              <th>CONTEXTO</th>
            </tr>
          </thead>
          <tbody>
            {works.map((work) => (
              <tr class:list={{ pending: work.status === 'A_CONFIRMAR' }} style={`--pulse:${work.corPulso || '#ffffff'};`}>
                <td class="num"><a href={`/obras/${work.slug}/`}>{work.numero}</a></td>
                <td class="title-cell">
                  <a href={`/obras/${work.slug}/`}>{work.titulo}</a>
                  <div class="title-desc">{work.description}</div>
                </td>
                <td>{work.ano}</td>
                <td>{work.local}</td>
                <td>{work.contexto}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="archive-links">
        <a href="/mapa/"><strong>mapa</strong> exploração relacional</a>
        <a href="/escritos/"><strong>escritos</strong> camada conceitual</a>
        <a href="/diario/"><strong>diário</strong> ateliê em processo</a>
        <a href="/publicacoes/"><strong>publicações</strong> circulação editorial</a>
        <a href="/trajetoria/"><strong>trajetória</strong> cronologia</a>
        <a href="/sobre/"><strong>sobre</strong> contexto</a>
        <a href="/en/"><strong>EN</strong> english</a>
        <a href="mailto:felipe@aya.cx">felipe@aya.cx</a>
      </div>
    </section>
  </main>
</Base>

<style is:global>
body.page-home{background:#000000;color:#ffffff}
body.page-home a{text-decoration:none}
</style>

<style>
:root{--paper:#000000;--ink:#ffffff;--line:rgba(255,255,255,.15);--line-strong:rgba(255,255,255,.28)}
.home{min-height:100vh;background:#000000}
.entry{min-height:100vh;padding:3rem 2rem 2rem;display:flex;flex-direction:column;justify-content:space-between;background:#000000;color:#ffffff}

.entry{position:relative;overflow:hidden}
.entry-strip{position:absolute;inset:0;display:grid;grid-template-columns:repeat(var(--cols,6),1fr);gap:0;z-index:0}
.entry-strip .strip-cell{display:block;overflow:hidden}
.entry-strip img{display:block;width:100%;height:100%;object-fit:cover;filter:saturate(1.05)}
.entry-strip::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.42) 0%,rgba(0,0,0,.22) 22%,rgba(0,0,0,.62) 52%,rgba(0,0,0,.34) 74%,rgba(0,0,0,.9) 100%)}
.entry h1 .given{font-weight:200;display:block;letter-spacing:-.03em}

.entry > *:not(.entry-strip){position:relative;z-index:1}
.entry h1{text-shadow:0 2px 40px rgba(0,0,0,.85)}
.entry-meta,.entry-hint{text-shadow:0 1px 14px rgba(0,0,0,.9)}
@media(max-width:1100px){.entry-strip{grid-template-columns:repeat(4,1fr)}.entry-strip .strip-cell:nth-child(n+5){display:none}}
@media(max-width:720px){.entry-strip{grid-template-columns:repeat(2,1fr)}.entry-strip .strip-cell:nth-child(n+3){display:none}}
.entry-meta,.entry-hint,.statement-label,.archive-kicker,.archive-links{font:.72rem/1 var(--mono);letter-spacing:.12em;text-transform:uppercase}
.entry-meta{color:rgba(255,255,255,.55)}
.entry h1{font:900 clamp(4rem,13vw,12rem)/.92 var(--sans);letter-spacing:-.05em;max-width:12ch}
.entry-hint{color:rgba(255,255,255,.45);text-align:right}
.statement{background:var(--paper);color:var(--ink);padding:4rem 2rem 5rem;border-top:1px solid rgba(255,255,255,.04)}
.statement-label{color:rgba(255,255,255,.45);margin-bottom:1rem}
.statement p{font:300 italic clamp(2rem,5vw,4.5rem)/1.05 var(--sans);max-width:12ch;letter-spacing:-.04em}
.archive{background:var(--paper);color:var(--ink);padding:0 2rem 3rem}
.archive-head{padding:0 0 1.5rem;border-bottom:1px solid var(--line-strong);margin-bottom:1.5rem}
.archive-kicker{color:rgba(255,255,255,.45);margin-bottom:.75rem}
.archive h2{font:700 clamp(2rem,4vw,3.5rem)/1 var(--sans);letter-spacing:-.05em;margin-bottom:.5rem}
.archive-meta{font:.8rem/1.5 var(--mono);color:rgba(255,255,255,.58);text-transform:uppercase;letter-spacing:.08em}
.archive-note{margin:.75rem 0 0;max-width:60ch;font:.95rem/1.55 var(--sans);color:rgba(255,255,255,.68)}
.archive-table-wrap{overflow:auto;border-top:1px solid var(--line)}
.archive-table{width:100%;border-collapse:collapse;min-width:980px}
.archive-table th,.archive-table td{padding:.9rem .65rem;vertical-align:top;border-bottom:1px solid var(--line)}
.archive-table th{font:.72rem/1 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.48);text-align:left}
.archive-table td{font:.92rem/1.45 var(--sans);color:rgba(255,255,255,.9)}
.archive-table td a{color:inherit}
.archive-table tbody tr{transition:background .15s ease}
.archive-table tbody tr:hover{background:rgba(255,255,255,.03)}
.archive-table tbody tr:hover .title-cell a{text-decoration:underline}
.archive-table tbody tr:hover .num{border-left-color:var(--pulse)}
.num{font:.8rem/1.2 var(--mono);color:rgba(255,255,255,.55);width:64px;border-left:3px solid transparent;padding-left:.8rem;transition:border-color .15s ease}
.title-cell{min-width:320px}
.title-cell a{font-weight:600;letter-spacing:-.01em}
.title-desc{margin-top:.3rem;font-size:.82rem;line-height:1.5;color:rgba(255,255,255,.58);max-width:52ch}
.archive-links{display:flex;gap:.7rem 1.25rem;flex-wrap:wrap;padding-top:1.5rem;color:rgba(255,255,255,.55);border-top:1px solid var(--line-strong);margin-top:1.5rem}
.archive-links a{color:inherit;display:flex;gap:.35rem;align-items:baseline}
.archive-links strong{font-weight:600;color:rgba(255,255,255,.78)}
.archive-links a:hover{color:var(--ink);text-decoration:underline}
@media (max-width: 900px){
  .entry,.statement,.archive{padding-left:1rem;padding-right:1rem}
  .entry{padding-top:1.25rem;padding-bottom:1.25rem}
  .statement{padding-top:3rem;padding-bottom:3rem}
  .archive{padding-bottom:2rem}
  .archive-meta{font-size:.72rem}
}
@media (max-width: 720px){
  .archive-table{min-width:0}
  .archive-table thead{display:none}
  .archive-table,.archive-table tbody{display:block}
  .archive-table tbody tr{display:grid;grid-template-columns:3.2rem minmax(0,1fr);column-gap:.5rem;padding:1.1rem 0;border-bottom:1px solid var(--line)}
  .archive-table td{display:block;border:0;padding:0;font-size:.88rem}
  .archive-table td.num{grid-row:1 / span 5;padding-left:.5rem;border-left:3px solid var(--pulse)}
  .title-cell{min-width:0}
  .title-cell a{font-size:1.05rem}
  .archive-table td:nth-child(3),.archive-table td:nth-child(4){color:rgba(255,255,255,.62);font:.74rem/1.5 var(--mono);letter-spacing:.06em;text-transform:uppercase}
  .archive-table td:nth-child(3){grid-column:2;margin-top:.5rem}
  .archive-table td:nth-child(4){grid-column:2}
  .archive-table td:nth-child(5){grid-column:2;color:rgba(255,255,255,.55);font-size:.82rem;margin-top:.15rem}
}
</style>
