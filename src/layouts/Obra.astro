---
import Base from './Base.astro';
import ObraDocumentacao from '../components/ObraDocumentacao.astro';
import ObraFicha from '../components/ObraFicha.astro';
import galleryData from '../data/gallery.json';
import worksData from '../data/works.json';
import regimeData from '../data/work-regimes.json';
import relationsData from '../data/map-relations.json';
import referencesData from '../data/references.json';
import publicationsData from '../data/publications.json';

type GalleryItem = { src: string; caption: string | null; captionEn?: string };

interface Props {
  frontmatter: {
    title: string;
    subtitle?: string;
    year: string;
    location: string;
    description?: string;
    hero?: string;
    credits?: Array<{role: string; name: string}>;
    press?: Array<{source: string; url: string; title: string}>;
    publications?: Array<{title: string; author?: string; pages?: string; url?: string; note?: string}>;
    series?: string;
    lead?: string;
    archiveNote?: string;
    mechanism?: Array<{label: string; value: string}>;
    circulation?: Array<{label: string; value: string}>;
    collaborationNote?: string;
    arquivosAbertos?: Array<{label: string; url: string; note?: string}>;
    entryLinks?: Array<{label: string; url: string}>;
    video?: {src: string; poster?: string; caption?: string; href?: string};
    cenas?: {src: string; poster?: string; caption?: string}[];
    filme?: {src: string; poster?: string; caption?: string};
    cenasHref?: string;
    cenasSorteio?: number;
    ogImage?: string;
    sameAs?: string[];
    artMedium?: string;
    galleryLabel?: {pt: string; en: string};
    galleryRatio?: string;
    lang?: 'pt' | 'en';
  };
}

const { frontmatter } = Astro.props;
const lang = frontmatter.lang || 'pt';
const isEN = lang === 'en';
const prefix = isEN ? '/en' : '';
const seoTitle = `Felipe Sztutman · ${frontmatter.title}`;
const seoDesc = frontmatter.description || `${frontmatter.title} (${frontmatter.year}) · ${frontmatter.location}. Felipe Sztutman.`;
const slug = Astro.url.pathname.replace(/^\/(?:en\/)?obras\//, '').replace(/\/$/, '');
const items: GalleryItem[] = ((galleryData as Record<string, GalleryItem[]>)[slug] || [])
  .map((item) => (isEN && item.captionEn ? { ...item, caption: item.captionEn } : item));
const ogImage = items[0]?.src || frontmatter.hero || frontmatter.ogImage || frontmatter.video?.poster || frontmatter.cenas?.[0]?.poster || undefined;
const lead = frontmatter.lead || frontmatter.description;

const works = ((worksData as any).works || []).slice().sort((a: any, b: any) => a.numero.localeCompare(b.numero));
const references = (referencesData as any).references || [];
const publications = (publicationsData as any).publications || [];
const relationSeeds = (relationsData as any).relations || [];

const work = works.find((entry: any) => entry.slug === slug) || null;
const artistCredits = frontmatter.credits?.filter((credit) => ['artista', 'artist'].includes(credit.role.toLowerCase())) || [];
const schemaCreatorNames = work?.authorshipMode === 'PROJETO_ARTISTA_TERCEIRO'
  ? artistCredits.map((credit) => credit.name)
  : work?.authorshipMode === 'COAUTORAL_FELIPE' && Array.isArray(work?.fichaTecnica?.concepcao)
    ? work.fichaTecnica.concepcao
    : ['Felipe Sztutman'];
const schemaOmitCreator = work?.authorshipMode === 'EXPOSICAO_TEMATICA' || work?.authorshipMode === 'DIRECAO_EXPERIENCIA' || (work?.authorshipMode === 'PROJETO_ARTISTA_TERCEIRO' && schemaCreatorNames.length === 0);
const pulse = work?.corPulso || '#00ccff';
const regimes = (regimeData as any).works || {};
const regime = work ? regimes[work.slug] : null;

const regimeLabels: Record<string, string> = {
  A: isEN ? 'foundational / territory / lineage' : 'fundacional / território / linhagem',
  B: isEN ? 'system / body / mechanism' : 'sistema / corpo / mecanismo',
  C: isEN ? 'space / circulation / collaboration' : 'espaço / circulação / colaboração',
};

function editorialStatus(entry: any) {
  if (!entry) return null;
  const labels: Record<string, {pt: string; en: string}> = {
    AUTORAL_FELIPE: { pt: 'obra autoral de Felipe', en: 'Felipe-authored work' },
    COAUTORAL_FELIPE: { pt: 'obra coautoral', en: 'co-authored work' },
    PROJETO_ARTISTA_TERCEIRO: { pt: 'projeto com artista terceiro', en: 'third-party artist project' },
    EXPOSICAO_TEMATICA: { pt: 'exposição temática / coletiva', en: 'thematic / collective exhibition' },
    DIRECAO_EXPERIENCIA: { pt: 'direção de experiência', en: 'experience direction' },
  };
  if (entry.status === 'A_CONFIRMAR') {
    if (entry.authorshipMode === 'EXPOSICAO_TEMATICA') return isEN ? 'exhibition under confirmation' : 'exposição em confirmação';
    return isEN ? 'project under confirmation' : 'projeto em confirmação';
  }
  if (entry.status === 'EM_CURSO') {
    if (entry.authorshipMode === 'EXPOSICAO_TEMATICA') return isEN ? 'exhibition in production' : 'exposição em produção';
    return isEN ? 'work in progress' : 'obra em curso';
  }
  if (entry.status === 'EM_EXPOSICAO' && entry.authorshipMode === 'EXPOSICAO_TEMATICA') return isEN ? 'exhibition on view' : 'exposição em cartaz';
  if (entry.authorshipMode && labels[entry.authorshipMode]) return isEN ? labels[entry.authorshipMode].en : labels[entry.authorshipMode].pt;
  if (entry.tipo === 'ARTE_PUBLICA') return isEN ? 'public art' : 'arte pública';
  if (entry.tipo === 'INTERVENCAO_URBANA') return isEN ? 'urban intervention' : 'intervenção urbana';
  if (entry.tipo === 'EXPOSICAO_DIRIGIDA') return isEN ? 'directed exhibition' : 'exposição dirigida';
  if (entry.tipo === 'INSTALACAO' && regime === 'B') return isEN ? 'installation-system' : 'instalação-sistema';
  if (entry.tipo === 'INSTALACAO' && regime === 'A') return isEN ? 'foundational gesture' : 'gesto fundacional';
  if (regime === 'C') return isEN ? 'spatial direction' : 'direção espacial';
  return isEN ? 'work' : 'obra';
}

function statusValue(entry: any) {
  if (!entry) return null;
  if (entry.status === 'A_CONFIRMAR') return isEN ? 'TO CONFIRM · published as archive in verification' : 'A CONFIRMAR · publicado como arquivo em verificação';
  if (entry.status === 'EM_CURSO') return isEN ? 'CONFIRMED · IN PRODUCTION' : 'CONFIRMADA · EM PRODUÇÃO';
  if (entry.status === 'EM_EXPOSICAO') {
    const period = entry.exposicao?.periodo?.[isEN ? 'en' : 'pt'];
    return (isEN ? 'ON VIEW' : 'EM EXPOSIÇÃO') + (period ? ` · ${period}` : '');
  }
  return isEN ? 'REALIZED' : 'REALIZADA';
}
const exhibition = work?.exposicao || null;
const schemaExhibition = exhibition ? {
  name: [exhibition.contexto, exhibition.local].filter(Boolean).join(', ') || frontmatter.title,
  startDate: exhibition.inicio,
  endDate: exhibition.fim,
  location: exhibition.local,
  city: exhibition.cidade,
  country: exhibition.pais,
} : undefined;
const currentIndex = works.findIndex((entry: any) => entry.slug === slug);
const previousWork = currentIndex > 0 ? works[currentIndex - 1] : null;
const nextWork = currentIndex >= 0 && currentIndex < works.length - 1 ? works[currentIndex + 1] : null;

const writingModules = import.meta.glob('../pages/escritos/*.md', { eager: true }) as Record<string, any>;
const writings = Object.entries(writingModules)
  .filter(([path]) => !path.endsWith('index.astro'))
  .map(([path, mod]) => {
    const id = path.split('/').pop()!.replace('.md', '');
    return {
      slug: id,
      title: mod.frontmatter.title as string,
      href: `${prefix}/escritos/${id}`,
    };
  });

function resolveEntity(kind: string, id: string) {
  if (kind === 'OBRA') {
    const found = works.find((entry: any) => entry.slug === id);
    return found ? { label: found.titulo, href: `${prefix}/obras/${found.slug}` } : null;
  }
  if (kind === 'ESCRITO') {
    const found = writings.find((entry) => entry.slug === id);
    return found ? { label: found.title, href: found.href } : null;
  }
  if (kind === 'PUBLICACAO') {
    const found = publications.find((entry: any) => entry.slug === id);
    return found ? { label: found.titulo, href: found.currentPublicPath || `${prefix}/publicacoes` } : null;
  }
  if (kind === 'REFERENCIA') {
    const found = references.find((entry: any) => entry.slug === id);
    return found ? { label: found.label, href: null } : null;
  }
  return null;
}

const publicRelations = relationSeeds
  .filter((relation: any) => relation.visibility === 'PUBLICA' && (relation.source === slug || relation.target === slug))
  .map((relation: any) => {
    const isSource = relation.source === slug;
    const relatedKind = isSource ? relation.targetKind : relation.sourceKind;
    const relatedId = isSource ? relation.target : relation.source;
    const related = resolveEntity(relatedKind, relatedId);
    return related ? {
      label: related.label,
      href: related.href,
      relationLabel: relation.label,
      notes: relation.notes,
      relationType: relation.relationType,
    } : null;
  })
  .filter(Boolean);

const TIPOS = {
  ARTE_PUBLICA: ['arte pública', 'public art'],
  EXPOSICAO_DIRIGIDA: ['exposição dirigida', 'directed exhibition'],
  EXPOSICAO_IMERSIVA: ['exposição imersiva', 'immersive exhibition'],
  INSTALACAO: ['instalação', 'installation'],
  INTERVENCAO_URBANA: ['intervenção urbana', 'urban intervention'],
};
const tipoLabel = (t) => TIPOS[t]?.[isEN ? 1 : 0] ?? t.replaceAll('_', ' ').toLowerCase();

const dossierRows = [
  work?.numero ? { label: isEN ? 'Number' : 'Número', value: work.numero } : null,
  work?.status ? { label: isEN ? 'Status' : 'Status', value: statusValue(work) } : null,
  work?.ano ? { label: isEN ? 'Year' : 'Ano', value: String(work.ano) } : null,
  work?.local ? { label: isEN ? 'Location' : 'Local', value: work.local } : null,
  work?.contexto ? { label: isEN ? 'Context' : 'Contexto', value: work.contexto } : null,
  work?.tipo ? { label: isEN ? 'Type' : 'Tipo', value: tipoLabel(work.tipo) } : null,
  work?.serie ? { label: isEN ? 'Series' : 'Série', value: work.serie } : null,
  work?.tecnicaMedium?.length ? { label: isEN ? 'Technique / medium' : 'Técnica / medium', value: work.tecnicaMedium.join(' · ') } : null,
  work?.fichaTecnica?.extensao ? { label: isEN ? 'Extension' : 'Extensão', value: work.fichaTecnica.extensao } : null,
  work?.fichaTecnica?.duracao ? { label: isEN ? 'Duration' : 'Duração', value: work.fichaTecnica.duracao } : null,
  work?.fichaTecnica?.realizacao?.length ? { label: isEN ? 'Realization' : 'Realização', value: work.fichaTecnica.realizacao.join(' · ') } : null,
].filter(Boolean);

const keyLabels = isEN ? ['Status', 'Year', 'Location', 'Type'] : ['Status', 'Ano', 'Local', 'Tipo'];
const keyRows = (dossierRows as Array<{label: string; value: string}>).filter((row) => keyLabels.includes(row.label));
if (!work) {
  keyRows.push({ label: isEN ? 'Year' : 'Ano', value: frontmatter.year }, { label: isEN ? 'Location' : 'Local', value: frontmatter.location });
}
const dossierRest = (dossierRows as Array<{label: string; value: string}>).filter((row) => !keyRows.includes(row));

// legenda da figura: sem o prefixo com o nome da obra e sem credito de foto
const titleKey = frontmatter.title.toLowerCase();
function cleanCaption(caption: string | null) {
  if (!caption) return '';
  const parts = caption.split(' · ').filter((part) => !/^\s*(foto|fotos|photo|photos)\b/i.test(part));
  if (parts.length > 1 && titleKey.startsWith(parts[0].trim().toLowerCase())) parts.shift();
  return parts.join(' · ').trim();
}

function imageAlt(item: GalleryItem, index: number) {
  const clean = cleanCaption(item.caption);
  return clean ? `${frontmatter.title} · ${clean}` : `${frontmatter.title} · ${isEN ? 'image' : 'imagem'} ${index + 1}`;
}

const hasDoc = items.length > 3;
const docPad = Math.max(2, String(items.length).length);
const docId = (index: number) => `doc-${String(index + 1).padStart(docPad, '0')}`;
const docItems = items.map((item, index) => ({ src: item.src, alt: imageAlt(item, index), caption: cleanCaption(item.caption) }));
---
<Base
  title={seoTitle}
  description={seoDesc}
  lang={lang}
  schemaType="ArtWork"
  schemaName={frontmatter.title}
  schemaDate={frontmatter.year}
  schemaLocation={frontmatter.location}
  schemaCreatorNames={schemaCreatorNames}
  schemaOmitCreator={schemaOmitCreator}
  schemaSameAs={frontmatter.sameAs}
  schemaMedium={frontmatter.artMedium}
  schemaExhibition={schemaExhibition}
  ogImage={ogImage}
  fullBleed={true}
  showHeader={false}
  showFooter={false}
  bodyClass="page-obra"
>
  <article class="obra-page" style={`--pulse:${pulse};`}>
    {items.length > 0 && (
      <div class="obra-hero" data-count={Math.min(items.length, 3)}>
        {items.slice(0, 3).map((item, index) => (
          <figure class="hero-cell">
            {hasDoc ? (
              <a href={`#${docId(index)}`} class="hero-link" aria-label={`${imageAlt(item, index)} · ${isEN ? 'open in documentation' : 'abrir na documentação'}`}>
                <img src={item.src} alt="" loading={index === 0 ? 'eager' : 'lazy'} />
              </a>
            ) : (
              <img src={item.src} alt={imageAlt(item, index)} loading={index === 0 ? 'eager' : 'lazy'} />
            )}
            {index === 0 && item.caption && <figcaption>{item.caption.split('·')[0].trim()}</figcaption>}
          </figure>
        ))}
      </div>
    )}
    <section class="obra-entry">
      <div class="surface-links">
        <a href={`${prefix}/#obras`} class="back">{isEN ? '← archive' : '← arquivo'}</a>
        <a href="/mapa" class="map-link">{isEN ? 'map relations (PT)' : 'mapa relacional'}</a>
      </div>
      <div class="eyebrow">
        {work?.numero ? (isEN ? `WORK No. ${work.numero}` : `OBRA Nº ${work.numero}`) : (isEN ? 'WORK' : 'OBRA')} · {frontmatter.year}
        {work?.status === 'A_CONFIRMAR' && <span class="status-chip">A CONFIRMAR</span>}
        {work?.status === 'EM_CURSO' && <span class="status-chip">{isEN ? 'IN PRODUCTION' : 'EM PRODUÇÃO'}</span>}
        {work?.status === 'EM_EXPOSICAO' && <span class="status-chip">{isEN ? 'ON VIEW' : 'EM EXPOSIÇÃO'}</span>}
      </div>
      <h1>{frontmatter.title}</h1>
      <div class="entry-meta">{work?.contexto || frontmatter.location}</div>
      {frontmatter.entryLinks && frontmatter.entryLinks.length > 0 && (
        <div class="entry-links">
          {frontmatter.entryLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noopener">{link.label} ↗</a>
          ))}
        </div>
      )}
      {work?.status === 'A_CONFIRMAR' && (
        <div class="pending-note">{isEN ? 'Published as archive in verification. Dates, documentation and expanded credits remain open.' : 'Publicado como arquivo em verificação. Datas, documentação e créditos expandidos permanecem abertos.'}</div>
      )}
      {work?.status === 'EM_CURSO' && (
        <div class="pending-note">{isEN ? 'Confirmed exhibition in production. Opening date, final documentation and expanded credits will be consolidated during production.' : 'Exposição confirmada e em produção. Data de abertura, documentação final e créditos expandidos serão consolidados ao longo da produção.'}</div>
      )}
      {work?.status === 'EM_EXPOSICAO' && exhibition?.periodo && (
        <div class="pending-note">{isEN ? `On view from ${exhibition.periodo.en}. ${frontmatter.location}.` : `Em exposição de ${exhibition.periodo.pt}. ${frontmatter.location}.`}</div>
      )}
    </section>


    <section class="narrative">
      <div class="section-kicker">{isEN ? 'Narrative text' : 'Texto narrativo'}</div>
      <div class="narrative-body">
        <slot />
      </div>
    </section>

    {frontmatter.video && (
      <section class="obra-video">
        <div class="section-kicker">{isEN ? 'Scene' : 'Cena'}</div>
        <figure>
          <video src={frontmatter.video.src} poster={frontmatter.video.poster} autoplay muted loop playsinline preload="metadata" aria-label={frontmatter.video.caption || frontmatter.title}></video>
          {frontmatter.video.caption && (
            <figcaption>
              {frontmatter.video.caption}
              {frontmatter.video.href && <> · <a href={frontmatter.video.href} target="_blank" rel="noopener">{isEN ? 'all scenes' : 'todas as cenas'} ↗</a></>}
            </figcaption>
          )}
        </figure>
      </section>
    )}

    {frontmatter.filme && (
      <section class="obra-video obra-filme" id="video">
        <div class="section-kicker">{isEN ? 'Video' : 'Vídeo'}</div>
        <figure>
          <video src={frontmatter.filme.src} poster={frontmatter.filme.poster} controls playsinline preload="none" aria-label={frontmatter.filme.caption || frontmatter.title}></video>
          {frontmatter.filme.caption && <figcaption>{frontmatter.filme.caption}</figcaption>}
        </figure>
      </section>
    )}

    {frontmatter.cenas?.length && (
      <section class="obra-video obra-cenas">
        <div class="section-kicker">{isEN ? 'Scenes' : 'Cenas'}</div>
        <figure>
          <video src={frontmatter.cenas[0].src} poster={frontmatter.cenas[0].poster} autoplay muted playsinline preload="auto" aria-label={frontmatter.cenas[0].caption || frontmatter.title} data-cenas={JSON.stringify(frontmatter.cenas)} data-sorteio={frontmatter.cenasSorteio || frontmatter.cenas.length}></video>
          <figcaption>
            <span class="cena-legenda">{frontmatter.cenas[0].caption}</span>
            {frontmatter.cenasHref && <> · <a href={frontmatter.cenasHref} target="_blank" rel="noopener">{isEN ? 'all scenes' : 'todas as cenas'} ↗</a></>}
          </figcaption>
        </figure>
        <script is:inline set:html={`
          (() => {
            const v = document.currentScript.closest('section').querySelector('video[data-cenas]');
            if (!v) return;
            // sorteio a cada visita: embaralha as candidatas e fica com N
            const todas = JSON.parse(v.dataset.cenas);
            for (let k = todas.length - 1; k > 0; k--) { const j = Math.floor(Math.random() * (k + 1)); [todas[k], todas[j]] = [todas[j], todas[k]]; }
            const cenas = todas.slice(0, Number(v.dataset.sorteio) || todas.length), leg = v.closest('figure').querySelector('.cena-legenda');
            const pre = new Image();
            let i = 0;
            const vai = n => {
              i = (n + cenas.length) % cenas.length;
              const c = cenas[i];
              v.poster = c.poster || ''; v.src = c.src; v.setAttribute('aria-label', c.caption || '');
              if (leg) leg.textContent = c.caption || '';
              v.play().catch(() => {});
              const prox = cenas[(i + 1) % cenas.length]; if (prox.poster) pre.src = prox.poster;
            };
            v.addEventListener('ended', () => vai(i + 1));
            vai(0);
            v.addEventListener('error', () => setTimeout(() => vai(i + 1), 500));
          })();
        `}></script>
      </section>
    )}

    {hasDoc && (
      <ObraDocumentacao
        items={docItems}
        isEN={isEN}
        label={frontmatter.galleryLabel ? (isEN ? frontmatter.galleryLabel.en : frontmatter.galleryLabel.pt) : undefined}
        ratio={frontmatter.galleryRatio}
      />
    )}

    <ObraFicha
      isEN={isEN}
      prefix={prefix}
      keyRows={keyRows}
      dossierRows={dossierRest}
      lead={lead}
      mechanism={frontmatter.mechanism}
      circulation={frontmatter.circulation}
      collaborationNote={frontmatter.collaborationNote}
      publicRelations={publicRelations as any}
      arquivosAbertos={frontmatter.arquivosAbertos}
      credits={frontmatter.credits}
      publications={frontmatter.publications}
      press={frontmatter.press}
      archiveNote={frontmatter.archiveNote}
    />

    {(previousWork || nextWork) && (
      <nav class="archive-nav" aria-label={isEN ? 'Archive navigation' : 'Navegação do arquivo'}>
        {previousWork ? (
          <a href={`${prefix}/obras/${previousWork.slug}`} class="archive-nav-item prev">
            <span class="archive-nav-label">{isEN ? 'Previous' : 'Anterior'}</span>
            <strong>{previousWork.numero} · {previousWork.titulo}</strong>
          </a>
        ) : <span />}
        {nextWork ? (
          <a href={`${prefix}/obras/${nextWork.slug}`} class="archive-nav-item next">
            <span class="archive-nav-label">{isEN ? 'Next' : 'Próxima'}</span>
            <strong>{nextWork.numero} · {nextWork.titulo}</strong>
          </a>
        ) : <span />}
      </nav>
    )}
  </article>
</Base>

<style is:global>
body.page-obra{background:#000000;color:#ffffff}
body.page-obra a{text-decoration:none}
</style>

<style>
:root{--paper:#000000;--ink:#ffffff;--line:rgba(255,255,255,.1);--paper-line:rgba(255,255,255,.16)}
.obra-page{background:#000000;color:#ffffff;padding:1.25rem 1rem 3rem;overflow-x:clip}
.obra-hero{display:grid;gap:0;margin:-1.25rem -1rem 1.75rem;grid-template-columns:1fr}
.obra-hero[data-count="2"]{grid-template-columns:repeat(2,1fr)}
.obra-hero[data-count="3"]{grid-template-columns:repeat(3,1fr)}
.hero-cell{position:relative;margin:0;overflow:hidden}
.hero-cell img{display:block;width:100%;height:44vh;min-height:230px;object-fit:cover;background:#000}
.hero-link{display:block}
.hero-link:focus-visible{outline:2px solid #fff;outline-offset:-2px}
.hero-cell figcaption{position:absolute;left:.85rem;bottom:.8rem;right:.85rem;font:.62rem/1.5 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:#fff;text-shadow:0 1px 12px rgba(0,0,0,.9);pointer-events:none}
@media(max-width:640px){.obra-hero[data-count="2"],.obra-hero[data-count="3"]{grid-template-columns:1fr}.hero-cell:nth-child(n+2){display:none}.hero-cell img{height:52vh}}

.obra-entry{padding:0 0 2rem;border-bottom:1px solid var(--line);margin-bottom:1.5rem}
.back,.map-link,.eyebrow,.status-chip{font:.72rem/1 var(--mono);letter-spacing:.12em;text-transform:uppercase}
.section-kicker{font:.62rem/1 var(--mono);letter-spacing:.26em;text-transform:uppercase;color:rgba(255,255,255,.55);margin-bottom:1.1rem}
.surface-links{display:flex;gap:1rem;align-items:center;flex-wrap:wrap;margin-bottom:1.25rem}
.back,.map-link{display:inline-block;color:rgba(255,255,255,.55)}
.back:hover,.map-link:hover{color:#fff}
.map-link{color:rgba(255,255,255,.38)}
.eyebrow{color:rgba(255,255,255,.5);margin-bottom:1rem;display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}
.eyebrow::before{content:'';width:6px;height:6px;background:var(--pulse);flex:0 0 auto}
.status-chip{color:#ffffff}
.obra-entry h1{font:900 clamp(2.8rem,10vw,8rem)/.9 var(--sans);letter-spacing:-.05em;max-width:10ch}
.entry-meta{margin-top:.85rem;font:.82rem/1.5 var(--mono);text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,.48)}
.entry-links{margin-top:1rem;display:flex;gap:1.1rem;flex-wrap:wrap;font:.82rem/1.4 var(--mono);letter-spacing:.06em;text-transform:lowercase}
.entry-links a{color:rgba(255,255,255,.8);text-decoration:underline;text-decoration-color:rgba(255,255,255,.3);text-underline-offset:.2em}
