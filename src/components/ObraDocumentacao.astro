---
// Documentacao da obra: um componente, dois comportamentos sobre os mesmos dados.
// "sequencia" (palco com uma foto inteira por vez + faixa de miniaturas) e
// "folha" (folha de contato). Sem JS: trilho com rolagem nativa e ancoras #doc-NN.
import { existsSync } from 'node:fs';
import path from 'node:path';

export type DocItem = { src: string; alt: string; caption: string };

interface Props {
  items: DocItem[];
  isEN: boolean;
  label?: string;
  ratio?: string;
}

const { items, isEN, label, ratio } = Astro.props;
const total = items.length;
const width = Math.max(2, String(total).length);
const pad = (n: number) => String(n).padStart(width, '0');
const title = label || (isEN ? 'Documentation' : 'Documentação');

// miniatura gerada por scripts/thumbs.mjs; se faltar, usa a imagem original
const publicDir = path.join(process.cwd(), 'public');
function thumbOf(src: string) {
  const thumb = src.replace(/\/([^/]+)\.(jpe?g|png)$/i, '/thumb/$1.webp');
  if (thumb === src) return src;
  return existsSync(path.join(publicDir, thumb)) ? thumb : src;
}
const slides = items.map((item, index) => ({ ...item, thumb: thumbOf(item.src), id: `doc-${pad(index + 1)}`, num: pad(index + 1) }));

const t = isEN
  ? { modes: 'View mode', seq: 'sequence', sheet: 'contact sheet', prev: 'Previous image', next: 'Next image', strip: 'Documentation images', image: 'Image', of: 'of', region: `${title}, ${total} images`, slide: 'image', carousel: 'carousel' }
  : { modes: 'Modo de visualização', seq: 'sequência', sheet: 'folha', prev: 'Imagem anterior', next: 'Próxima imagem', strip: 'Imagens da documentação', image: 'Imagem', of: 'de', region: `${title}, ${total} imagens`, slide: 'imagem', carousel: 'carrossel' };
---
<section class="doc" id="documentacao" data-mode="sequencia" aria-labelledby="doc-title">
  <div class="doc-head">
    <h2 class="doc-kicker" id="doc-title">{title} · {total}</h2>
    <div class="doc-modes" role="group" aria-label={t.modes} hidden>
      <button type="button" data-set-mode="sequencia" aria-pressed="true">{t.seq}</button>
      <button type="button" data-set-mode="folha" aria-pressed="false">{t.sheet}</button>
    </div>
  </div>

  <div class="doc-seq">
    <div class="stage">
      <div class="track" tabindex="0" role="region" aria-roledescription={t.carousel} aria-label={t.region}>
        {slides.map((slide, index) => (
          <figure class="slide" id={slide.id} role="group" aria-roledescription={t.slide} aria-label={`${slide.num} / ${pad(total)}`}>
            <img src={slide.src} alt={slide.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
            <figcaption><span class="num">{slide.num} / {pad(total)}</span>{slide.caption && <span class="txt">{slide.caption}</span>}</figcaption>
          </figure>
        ))}
      </div>
      <button type="button" class="nav prev" aria-label={t.prev} hidden><span aria-hidden="true">←</span></button>
      <button type="button" class="nav next" aria-label={t.next} hidden><span aria-hidden="true">→</span></button>
    </div>
    <nav class="strip" aria-label={t.strip}>
      {slides.map((slide, index) => (
        <a href={`#${slide.id}`} data-i={index} aria-label={`${t.image} ${slide.num} ${t.of} ${pad(total)}`} aria-current={index === 0 ? 'true' : undefined}>
          <img src={slide.thumb} alt="" loading="lazy" decoding="async" />
        </a>
      ))}
    </nav>
    <p class="sr-only doc-status" aria-live="polite"></p>
  </div>

  <div class="sheet" style={ratio ? `--ratio:${ratio}` : undefined}>
    {slides.map((slide, index) => (
      <a href={`#${slide.id}`} data-i={index}>
        <img src={slide.thumb} alt={`${slide.num} / ${pad(total)} · ${slide.alt}`} loading="lazy" decoding="async" />
      </a>
    ))}
  </div>
</section>

<script>
  const KEY = 'obra-doc-modo';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('section.doc').forEach((doc) => {
    const track = doc.querySelector<HTMLElement>('.track')!;
    const slides = [...doc.querySelectorAll<HTMLElement>('.slide')];
    const strip = doc.querySelector<HTMLElement>('.strip')!;
    const thumbs = [...strip.querySelectorAll<HTMLAnchorElement>('a')];
    const prev = doc.querySelector<HTMLButtonElement>('.nav.prev')!;
    const next = doc.querySelector<HTMLButtonElement>('.nav.next')!;
    const modes = doc.querySelector<HTMLElement>('.doc-modes')!;
    const status = doc.querySelector<HTMLElement>('.doc-status')!;
    const n = slides.length;
    let cur = 0;
    let touched = false;

    const behavior = (): ScrollBehavior => (reduce.matches ? 'auto' : 'smooth');
    const indexFromHash = (hash: string) => slides.findIndex((slide) => `#${slide.id}` === hash);

    function syncStrip() {
      thumbs.forEach((thumb, k) => {
        if (k === cur) thumb.setAttribute('aria-current', 'true');
        else thumb.removeAttribute('aria-current');
      });
      const thumb = thumbs[cur];
      if (!thumb) return;
      const left = thumb.offsetLeft;
      const right = left + thumb.offsetWidth;
      if (left < strip.scrollLeft || right > strip.scrollLeft + strip.clientWidth) {
        strip.scrollTo({ left: left - (strip.clientWidth - thumb.offsetWidth) / 2, behavior: behavior() });
      }
      prev.setAttribute('aria-disabled', String(cur === 0));
      next.setAttribute('aria-disabled', String(cur === n - 1));
    }

    function setCurrent(i: number, announce: boolean) {
      const changed = i !== cur;
      cur = i;
      syncStrip();
      if (changed && touched) {
        try {
          history.replaceState(history.state, '', `#${slides[cur].id}`);
        } catch {}
      }
      if (announce) {
        const caption = slides[cur].querySelector('.txt')?.textContent || '';
        status.textContent = `${slides[cur].querySelector('.num')?.textContent || ''}${caption ? ` · ${caption}` : ''}`;
      }
    }

    function go(i: number, opts: { instant?: boolean; announce?: boolean } = {}) {
      const target = Math.max(0, Math.min(n - 1, i));
      touched = true;
      track.scrollTo({ left: target * track.clientWidth, behavior: opts.instant ? 'auto' : behavior() });
      setCurrent(target, opts.announce !== false);
    }

    function setMode(mode: string, remember: boolean) {
      const m = mode === 'folha' ? 'folha' : 'sequencia';
      doc.dataset.mode = m;
      modes.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setMode === m)));
      if (m === 'sequencia') track.scrollTo({ left: cur * track.clientWidth, behavior: 'auto' });
      if (remember) {
        try {
          localStorage.setItem(KEY, m);
        } catch {}
      }
    }

    // rolagem nativa (toque, trackpad) define a posicao
    let timer = 0;
    const onSettle = () => {
      if (doc.dataset.mode !== 'sequencia' || !track.clientWidth) return;
      const i = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
      if (i !== cur) {
        touched = true;
        setCurrent(Math.max(0, Math.min(n - 1, i)), false);
      }
    };
    track.addEventListener('scroll', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(onSettle, 110);
    }, { passive: true });

    prev.addEventListener('click', () => go(cur - 1));
    next.addEventListener('click', () => go(cur + 1));

    doc.querySelector('.doc-seq')!.addEventListener('keydown', (event) => {
      const e = event as KeyboardEvent;
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      const map: Record<string, number> = { ArrowLeft: cur - 1, ArrowRight: cur + 1, Home: 0, End: n - 1 };
      if (!(e.key in map)) return;
      e.preventDefault();
      go(map[e.key]);
    });

    modes.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => setMode(b.dataset.setMode || 'sequencia', true)));

    // qualquer link #doc-NN na pagina (faixa, folha, heroi) abre o palco naquela foto
    document.addEventListener('click', (event) => {
      const link = (event.target as Element).closest?.('a[href^="#doc-"]') as HTMLAnchorElement | null;
      if (!link) return;
      const i = indexFromHash(link.getAttribute('href') || '');
      if (i < 0) return;
      event.preventDefault();
      const fromStrip = strip.contains(link);
      if (doc.dataset.mode !== 'sequencia') setMode('sequencia', false);
      go(i, { instant: !fromStrip });
      if (!fromStrip) {
        doc.scrollIntoView({ block: 'start', behavior: behavior() });
        track.focus({ preventScroll: true });
      }
    });

    window.addEventListener('resize', () => {
      track.scrollTo({ left: cur * track.clientWidth, behavior: 'auto' });
    });

    // estado inicial: modo lembrado, link direto por foto
    doc.classList.add('js');
    modes.hidden = false;
    prev.hidden = false;
    next.hidden = false;
    let saved: string | null = null;
    try {
      saved = localStorage.getItem(KEY);
    } catch {}
    const fromHash = indexFromHash(location.hash);
    if (fromHash >= 0) {
      setMode('sequencia', false);
      cur = fromHash;
      requestAnimationFrame(() => {
        track.scrollTo({ left: fromHash * track.clientWidth, behavior: 'auto' });
        syncStrip();
      });
    } else {
      if (saved === 'folha') setMode('folha', false);
      syncStrip();
    }
  });
</script>

<style>
  .doc{padding:.5rem 0 2.5rem}
  .doc-head{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;margin-bottom:1rem}
  .doc-kicker{font:400 .62rem/1 var(--mono);letter-spacing:.26em;text-transform:uppercase;color:rgba(255,255,255,.55)}
  .doc-modes{display:flex;gap:1.1rem;font:.68rem/1 var(--mono);letter-spacing:.14em;text-transform:uppercase}
  .doc-modes[hidden]{display:none}
  .doc-modes button{appearance:none;background:none;border:0;border-radius:0;font:inherit;letter-spacing:inherit;text-transform:inherit;cursor:pointer;color:rgba(255,255,255,.45);padding:.4rem 0}
  .doc-modes button:hover{color:#fff}
  .doc-modes button[aria-pressed="true"]{color:#fff;box-shadow:inset 0 -1px 0 #fff}

  .stage{position:relative;margin:0 -1rem}
  .track{display:flex;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain}
  .track::-webkit-scrollbar{display:none}
  .slide{flex:0 0 100%;min-width:0;scroll-snap-align:center;scroll-snap-stop:always;margin:0}
  .slide img{display:block;width:100%;height:clamp(240px,62vh,720px);object-fit:contain;background:#000}
  .slide figcaption{display:grid;grid-template-columns:auto 1fr;gap:1rem;padding:.7rem 1rem .9rem;font:.72rem/1.5 var(--mono);color:rgba(255,255,255,.55)}
  .slide .num{color:#fff;letter-spacing:.08em;white-space:nowrap}

  .nav{position:absolute;top:0;height:clamp(240px,62vh,720px);width:22%;display:flex;align-items:center;appearance:none;background:none;border:0;border-radius:0;cursor:pointer;font:1.4rem/1 var(--mono);color:rgba(255,255,255,0);transition:color .2s}
  .nav[hidden]{display:none}
  .stage:hover .nav,.nav:focus-visible{color:rgba(255,255,255,.85)}
  .nav[aria-disabled="true"]{cursor:default}
  .stage:hover .nav[aria-disabled="true"]{color:rgba(255,255,255,.18)}
  .prev{left:0;justify-content:flex-start;padding-left:1.25rem}
  .next{right:0;justify-content:flex-end;padding-right:1.25rem}

  .strip{position:relative;display:flex;gap:4px;overflow-x:auto;scroll-snap-type:x proximity;scrollbar-width:none;padding:2px 0 4px}
  .strip::-webkit-scrollbar{display:none}
  .strip a{flex:0 0 auto;scroll-snap-align:start;opacity:.38;transition:opacity .2s;box-shadow:inset 0 -2px 0 transparent;padding-bottom:4px}
  .strip a:hover{opacity:.75}
  .strip a[aria-current="true"]{opacity:1;box-shadow:inset 0 -2px 0 #fff}
  .strip img{display:block;height:64px;width:auto;aspect-ratio:3/2;object-fit:cover;background:#111}

  .sheet{display:none;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:4px}
  .sheet a{display:block}
  .sheet a:hover img{opacity:.8}
  .sheet img{display:block;width:100%;aspect-ratio:var(--ratio,3/2);object-fit:cover;background:#111}
  .doc[data-mode="folha"] .doc-seq{display:none}
  .doc[data-mode="folha"] .sheet{display:grid}

  .track:focus-visible,.strip a:focus-visible,.sheet a:focus-visible,.doc-modes button:focus-visible{outline:2px solid #fff;outline-offset:-2px}
  .nav:focus-visible{outline:2px solid #fff;outline-offset:-4px}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

  @media (min-width: 900px){
    .stage{margin:0 -2rem}
    .slide figcaption{padding:.7rem 2rem .9rem}
  }
  @media (max-width: 640px){
    .slide img{height:auto;aspect-ratio:4/3}
    .slide figcaption{grid-template-columns:1fr;gap:.2rem}
    .strip img{height:52px}
    .nav{display:none}
    .sheet{grid-template-columns:repeat(3,minmax(0,1fr))}
  }
  @media (prefers-reduced-motion: reduce){
    .track,.strip{scroll-behavior:auto}
    .strip a,.nav{transition:none}
  }
</style>
