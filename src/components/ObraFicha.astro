---
// Ficha da obra: dados-chave e creditos sempre visiveis; o resto em <details>
// separados por linhas finas (linhas, nao caixas). HTML nativo, sem JS.
type Row = { label: string; value: string };
type Relation = { label: string; href: string | null; relationLabel?: string; notes?: string };

interface Props {
  isEN: boolean;
  prefix: string;
  keyRows: Row[];
  dossierRows: Row[];
  lead?: string;
  mechanism?: Row[];
  circulation?: Row[];
  collaborationNote?: string;
  publicRelations?: Relation[];
  arquivosAbertos?: Array<{label: string; url: string; note?: string}>;
  credits?: Array<{role: string; name: string}>;
  publications?: Array<{title: string; author?: string; pages?: string; url?: string; note?: string}>;
  press?: Array<{source: string; url: string; title: string}>;
  archiveNote?: string;
}

const {
  isEN,
  prefix,
  keyRows,
  dossierRows,
  lead,
  mechanism = [],
  circulation = [],
  collaborationNote,
  publicRelations = [],
  arquivosAbertos = [],
  credits = [],
  publications = [],
  press = [],
  archiveNote,
} = Astro.props;

function normalizePublicationUrl(url?: string) {
  if (!url) return null;
  if (url.includes('/publicacoes/')) return `${prefix}/publicacoes`;
  return url;
}

const hasDossier = Boolean(lead) || dossierRows.length > 0;
---
<section class="ficha" aria-labelledby="ficha-title">
  <h2 class="ficha-kicker" id="ficha-title">{isEN ? 'Fact sheet' : 'Ficha'}</h2>

  {keyRows.length > 0 && (
    <dl class="ficha-key">
      {keyRows.map((row) => (
        <div>
          <dt>{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))}
    </dl>
  )}

  {credits.length > 0 && (
    <div class="ficha-credits">
      <h3 class="ficha-kicker" id="ficha-credits-title">{isEN ? 'Credits' : 'Créditos'}</h3>
      <dl class="credits-list">
        {credits.map((credit) => (
          <div class="credit-row">
            <dt>{credit.role}</dt>
            <dd>{credit.name}</dd>
          </div>
        ))}
      </dl>
    </div>
  )}

  <div class="ficha-more">
    {hasDossier && (
      <details>
        <summary><span class="sum-title">{isEN ? 'Dossier' : 'Dossiê'}</span>{dossierRows.length > 0 && <span class="sum-count">{dossierRows.length}</span>}</summary>
        <div class="more-body">
          {lead && <p class="lead">{lead}</p>}
          {dossierRows.length > 0 && (
            <dl class="rows">
              {dossierRows.map((row) => (
                <div class="row">
                  <dt>{row.label}</dt>
                  <dd>{row.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </details>
    )}

    {mechanism.length > 0 && (
      <details>
        <summary><span class="sum-title">{isEN ? 'Mechanism' : 'Mecanismo'}</span><span class="sum-count">{mechanism.length}</span></summary>
        <div class="more-body">
          <dl class="rows">
            {mechanism.map((item) => (
              <div class="row">
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </details>
    )}

    {circulation.length > 0 && (
      <details>
        <summary><span class="sum-title">{isEN ? 'Circulation' : 'Circulação'}</span><span class="sum-count">{circulation.length}</span></summary>
        <div class="more-body">
          <dl class="rows">
            {circulation.map((item) => (
              <div class="row">
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </details>
    )}

    {collaborationNote && (
      <details>
        <summary><span class="sum-title">{isEN ? 'Collaboration' : 'Co-criação'}</span></summary>
        <div class="more-body">
          <p class="note">{collaborationNote}</p>
        </div>
      </details>
    )}

    {publicRelations.length > 0 && (
      <details>
        <summary><span class="sum-title">{isEN ? 'Public relations' : 'Relações públicas'}</span><span class="sum-count">{publicRelations.length}</span></summary>
        <div class="more-body">
          <p class="intro">{isEN ? 'Public connections that situate this work inside the archive before the narrative text.' : 'Conexões públicas que situam esta obra no arquivo antes do texto narrativo.'}</p>
          <div class="relation-list">
            {publicRelations.map((relation) => (
              <div class="relation-item">
                <div class="relation-label">{relation.relationLabel || (isEN ? 'Relation' : 'Relação')}</div>
                {relation.href ? (
                  <a href={relation.href} class="relation-target">{relation.label}</a>
                ) : (
                  <span class="relation-target static">{relation.label}</span>
                )}
                {relation.notes && <div class="relation-notes">{relation.notes}</div>}
              </div>
            ))}
          </div>
        </div>
      </details>
    )}

    {arquivosAbertos.length > 0 && (
      <details>
        <summary><span class="sum-title">{isEN ? 'Open files' : 'Arquivos abertos'}</span><span class="sum-count">{arquivosAbertos.length}</span></summary>
        <div class="more-body">
          <p class="intro">{isEN ? 'Working surfaces, code, and measurements published as the work is made.' : 'Superfícies de trabalho, código e medidas publicados enquanto a obra é feita.'}</p>
          <div class="stack-list">
            {arquivosAbertos.map((file) => (
              <div class="stack-row">
                <a href={file.url} target="_blank" rel="noopener"><strong>{file.label}</strong></a>
                {file.note && <span>{file.note}</span>}
              </div>
            ))}
          </div>
        </div>
      </details>
    )}

    {publications.length > 0 && (
      <details>
        <summary><span class="sum-title">{isEN ? 'Publication' : 'Publicação'}</span><span class="sum-count">{publications.length}</span></summary>
        <div class="more-body">
          <div class="stack-list">
            {publications.map((publication) => (
              <div class="stack-row">
                {normalizePublicationUrl(publication.url) ? <a href={normalizePublicationUrl(publication.url)!}><strong>{publication.title}</strong></a> : <strong>{publication.title}</strong>}
                {(publication.author || publication.pages) && <span>{publication.author}{publication.author && publication.pages ? ' · ' : ''}{publication.pages || ''}</span>}
                {publication.note && <span>{publication.note}</span>}
              </div>
            ))}
          </div>
        </div>
      </details>
    )}

    {press.length > 0 && (
      <details>
        <summary><span class="sum-title">{isEN ? 'Press' : 'Imprensa'}</span><span class="sum-count">{press.length}</span></summary>
        <div class="more-body">
          <div class="stack-list">
            {press.map((item) => (
              <div class="stack-row">
                <a href={item.url} target="_blank" rel="noopener"><strong>{item.source}</strong></a>
                <span>{item.title}</span>
              </div>
            ))}
          </div>
        </div>
      </details>
    )}

    {archiveNote && (
      <details>
        <summary><span class="sum-title">{isEN ? 'Archive note' : 'Nota de arquivo'}</span></summary>
        <div class="more-body">
          <p class="note">{archiveNote}</p>
        </div>
      </details>
    )}
  </div>
</section>

<style>
  .ficha{border-top:1px solid rgba(255,255,255,.14);padding-top:1.15rem;margin:0}
  .ficha-kicker{font:400 .62rem/1 var(--mono);letter-spacing:.26em;text-transform:uppercase;color:rgba(255,255,255,.55);margin-bottom:1.1rem}
  .ficha-key{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,140px),1fr));gap:.9rem 2rem;padding:0 0 1.6rem}
  .ficha-key dt,.credit-row dt,.row dt{font:.66rem/1.4 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.5)}
  .ficha-key dd{font:.95rem/1.45 var(--sans);color:#fff;margin-top:.2rem}

  .ficha-credits{padding:0 0 1.6rem}
  .credits-list{column-gap:3.5rem}
  .credit-row{break-inside:avoid;padding-bottom:.6rem;display:grid;grid-template-columns:minmax(0,15rem) 1fr;gap:1rem;align-items:baseline}
  .credit-row dd{font:.95rem/1.5 var(--sans);color:#fff}

  .ficha-more details{border-top:1px solid rgba(255,255,255,.1)}
  .ficha-more summary{list-style:none;cursor:pointer;display:flex;align-items:baseline;gap:1rem;padding:.95rem 0;font:.68rem/1.2 var(--mono);letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.78)}
  .ficha-more summary::-webkit-details-marker{display:none}
  .ficha-more summary::after{content:'+';margin-left:auto;letter-spacing:0;font-size:.9rem;line-height:1;color:rgba(255,255,255,.55)}
  .ficha-more details[open] > summary::after{content:'\2212'}
  .ficha-more summary:hover{color:#fff}
  .ficha-more summary:focus-visible{outline:2px solid #fff;outline-offset:2px}
  .sum-count{color:rgba(255,255,255,.38);letter-spacing:.08em}
  .more-body{padding:0 0 1.5rem}

  .lead{font:400 1.05rem/1.6 var(--sans);margin-bottom:1rem;max-width:56ch;color:#fff}
  .rows{display:grid;gap:.62rem}
  .row{display:grid;grid-template-columns:150px 1fr;gap:1rem;padding:.1rem 0}
  .row dd{font:.95rem/1.55 var(--sans);color:rgba(255,255,255,.92)}
  .intro{font:.92rem/1.55 var(--sans);color:rgba(255,255,255,.62);max-width:58ch;margin:0 0 1rem}
  .note{font:.92rem/1.65 var(--sans);color:rgba(255,255,255,.74);max-width:62ch}
  .relation-list{display:grid;gap:1rem}
  .relation-item{padding-top:.2rem}
  .relation-label{font:.72rem/1.2 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.55);margin-bottom:.35rem}
  .relation-target{font:600 1rem/1.4 var(--sans);color:#fff}
  a.relation-target:hover{text-decoration:underline}
  .relation-target.static{display:inline-block}
  .relation-notes{margin-top:.2rem;font:.86rem/1.5 var(--sans);color:rgba(255,255,255,.62)}
  .stack-list{display:grid;gap:.75rem}
  .stack-row{display:flex;flex-direction:column;gap:.15rem;font:.92rem/1.5 var(--sans)}
  .stack-row span{color:rgba(255,255,255,.65)}
  .stack-row strong{color:#fff}
  .stack-row a{color:#fff}
  .stack-row a:hover strong{text-decoration:underline}
  .ficha a:focus-visible{outline:2px solid #fff;outline-offset:2px}

  @media (min-width: 1100px){
    .rows{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:3.5rem}
    .credits-list{columns:2}
  }
  @media (max-width: 720px){
    .row,.credit-row{grid-template-columns:1fr;gap:.2rem}
    .credit-row{padding-bottom:.85rem}
  }
</style>
